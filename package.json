{
  "name": "counter-app",
  "version": "1.0.0",
  "description": "Lightweight, stateful counter app with theme toggle and persistence",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "pretest": "node scripts/build-distribution.mjs",
    "dev": "vite",
    "report": "node .agents/scripts/report.mjs",
    "context": "node .agents/scripts/context.mjs",
    "benchmark:context": "node .agents/scripts/context-benchmark.mjs",
    "change:scope": "node .agents/scripts/change-scope.mjs",
    "verify:plan": "node .agents/scripts/verify-plan.mjs",
    "plan": "node .agents/scripts/plan.mjs",
    "index": "node .agents/scripts/index.mjs",
    "workflow:check": "node .agents/scripts/workflow-check.mjs",
    "workflow:mode": "node .agents/scripts/mode.mjs",
    "workflow:archive": "node .agents/scripts/archive.mjs",
    "docs:check": "node .agents/scripts/doc-check.mjs",
    "distribution:build": "node scripts/build-distribution.mjs",
    "distribution:check": "node scripts/build-distribution.mjs --check",
    "distribution:pack": "npm pack ./packages/agent-workflow-scrum",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs"
  },
  "keywords": [
    "counter",
    "workflow",
    "example"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "vite": "^8.0.0"
  }
}
