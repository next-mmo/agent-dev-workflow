{
  "name": "counter-app",
  "version": "1.0.0",
  "description": "Lightweight, stateful counter app with theme toggle and persistence",
  "type": "module",
  "bin": {
    "agent-workflow": "./packages/agent-workflow-scrum/bin/agent-workflow.mjs"
  },
  "files": [
    "packages/agent-workflow-scrum/bin/",
    "packages/agent-workflow-scrum/src/",
    "packages/agent-workflow-scrum/engine/",
    "packages/agent-workflow-scrum/templates/",
    "packages/agent-workflow-scrum/plugin/",
    "packages/agent-workflow-scrum/package.json",
    "packages/agent-workflow-scrum/README.md",
    "packages/agent-workflow-scrum/LICENSE",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "pretest": "node scripts/build-distribution.mjs",
    "dev": "vite",
    "dev:full": "node src/server/start.js --dev",
    "start": "node src/server/start.js",
    "local:check": "npm test && npm run build && npm run workflow:check -- --mode strict && npm run docs:check && npm run distribution:check",
    "trial:measure": "node scripts/developer-trial-measure.mjs",
    "report": "agent-workflow report",
    "context": "agent-workflow context",
    "benchmark:context": "node scripts/context-benchmark.mjs",
    "change:scope": "agent-workflow scope",
    "verify:plan": "agent-workflow verify",
    "plan": "agent-workflow plan",
    "index": "agent-workflow index",
    "solve": "agent-workflow solve",
    "review": "agent-workflow review",
    "worktree": "agent-workflow worktree",
    "prd:sync": "agent-workflow prdsync",
    "workflow:check": "agent-workflow check",
    "workflow:mode": "agent-workflow mode",
    "workflow:archive": "agent-workflow archive",
    "docs:check": "agent-workflow docs",
    "distribution:build": "node scripts/build-distribution.mjs",
    "distribution:check": "node scripts/build-distribution.mjs --check",
    "distribution:pack": "npm pack ./packages/agent-workflow-scrum",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:compact": "node --test --test-reporter=dot tests/*.test.cjs tests/*.test.mjs"
  },
  "keywords": [
    "counter",
    "workflow",
    "example"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@next-mmo/agent-workflow-scrum": "file:packages/agent-workflow-scrum",
    "vite": "^8.0.0"
  }
}
