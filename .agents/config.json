{
  "schemaVersion": 1,
  "packageManager": "npm",
  "paths": {
    "product": [
      "src/**",
      "examples/**",
      "public/**",
      "index.html"
    ],
    "tests": [
      "tests/**",
      "**/*.test.*",
      "**/*.spec.*"
    ],
    "docs": [
      "README.md",
      "AGENT-QUICKSTART.md",
      ".agents/docs/**"
    ],
    "workflow": [
      "AGENTS.md",
      "CONTEXT.md",
      ".agents/**",
      "packages/agent-workflow-scrum/**",
      "scripts/**"
    ],
    "ci": [
      ".github/**"
    ],
    "build": [
      "package.json",
      "package-lock.json",
      "vite.config.*",
      "tsconfig*",
      "Dockerfile*",
      "docker-compose*"
    ]
  },
  "checks": {
    "test": "npm test",
    "build": "npm run build",
    "workflow": "npm run workflow:check --",
    "docs": "npm run docs:check",
    "skills": "bash scripts/skill.sh check"
  },
  "contextBudgets": {
    "AGENTS.md": 800,
    "CONTEXT.md": 1400,
    ".agents/skills/agent-workflow-scrum/SKILL.md": 900
  },
  "docBudgets": {
    "AGENT-QUICKSTART.md": 2200,
    "AGENTS.md": 800,
    "CONTEXT.md": 1400,
    ".agents/skills/agent-workflow-scrum/SKILL.md": 900,
    ".agents/skills/agent-workflow-prose/SKILL.md": 1000,
    ".agents/docs/AGENTS.md": 900,
    ".agents/docs/architecture.md": 2000,
    ".agents/docs/development.md": 1600,
    ".agents/docs/testing.md": 1200,
    ".agents/docs/defensive-patterns.md": 1000,
    "packages/agent-workflow-scrum/engine/AGENTS.md": 700,
    "tests/AGENTS.md": 700
  },
  "ignore": [
    "dist/**",
    "coverage/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.map",
    "node_modules/**",
    ".playwright-mcp/**",
    "scratch/**"
  ],
  "mode": "vibe",
  "archive": {
    "autoArchiveDone": true,
    "retentionDays": 14
  }
}
